# Copy to .env and set the password. .env is gitignored; never commit it.

# Connection the API and the data scripts use. For the compose stack only
# NEO4J_PASSWORD matters (the stack wires the URI itself); for local
# development point the URI at your Neo4j (docs/decisions.md uses 7688).
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Where the datasets are downloaded (never committed).
DATA_DIR=data

# Optional: a disposable database for the integration tests. THE TESTS WIPE
# IT. Leave unset to skip them.
NEO4J_TEST_URI=bolt://localhost:7689
